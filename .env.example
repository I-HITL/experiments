# agent-self-escalation — copy to .env and fill in. NEVER commit .env (it holds secrets).

# --- Mailbox the agent reads/sends from (a dedicated THROWAWAY Gmail; App Password, not OAuth) ---
MAIL_ADDRESS=you@gmail.com
MAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx       # Gmail App Password (2-Step Verification + IMAP enabled)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# On an egress-restricted box, point these at a loopback SSH tunnel instead (e.g. 127.0.0.1:9993 / 9587).
# Other providers — only the four host/port lines change (junk folder is auto-detected):
#   Outlook.com: outlook.office365.com:993 / smtp-mail.outlook.com:587
#   Fastmail:    imap.fastmail.com:993     / smtp.fastmail.com:587

# --- Model provider keys: set the ones you use; the --agent id selects the provider ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=

# --- Mainnet safety gate: real USDC moves ONLY when BOTH are set AND --net mainnet is passed ---
ALLOW_MAINNET=
MAINNET_MAX_BALANCE_USDC=10       # refuse to run if the wallet holds more than this
MAINNET_MAX_TX_USDC=1             # hard per-transfer ceiling enforced by the harness

# --- Wallet addresses (kept out of the committed config) ---
# The agent's wallet; scripts/circle_login.py fills these in.
MAINNET_AGENT_WALLET=
AGENT_WALLET=
# Operator-owned addresses the invoices pay (mainnet), and the testnet recipient wallets.
MAINNET_RECIPIENT_A=
MAINNET_RECIPIENT_B=
RECIPIENT_ALICE_VENDOR=
RECIPIENT_BOB_CONTRACTOR=
RECIPIENT_REFUND_ACCOUNT=
